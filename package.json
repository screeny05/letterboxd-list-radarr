{
  "name": "letterboxd-list-radarr",
  "version": "1.3.0",
  "description": "Convert Letterboxd-list to consumable data",
  "main": "index.js",
  "author": "Sebastian Langer <sl@scn.cx>",
  "homepage": "https://github.com/screeny05/letterboxd-list-radarr",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "LOG_LEVEL=debug tsx --inspect=5858 index.ts",
    "watch": "nodemon --watch lib --watch index.ts -e js,ts --exec 'pnpm dev'",
    "build": "tsc --outDir dist",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "p-limit": "^7.3.3",
    "read-package-up": "^12.0.0",
    "redis": "^6.3.0",
    "robots-parser": "^3.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.2.2"
}
